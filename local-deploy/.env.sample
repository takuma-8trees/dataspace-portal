# Copy this to .env and fill in secrets before running
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
OAUTH2_PROXY_COOKIE_SECRET=32-byte-base64==
OAUTH2_PROXY_CLIENT_SECRET=change-me
AP_CLIENT_SECRET=change-me
AP_CONFIG_API_KEY=change-me

# Catalog crawler settings
# Client ID (SKI/AKI) registered in Keycloak/DAPS for the crawler
CRAWLER_EDC_CLIENT_ID=change-me
# JDBC URL the crawler uses to write/read crawler data (can point to the AP DB or a dedicated DB)
CRAWLER_DB_JDBC_URL=jdbc:postgresql://postgres/authority_portal
CRAWLER_DB_JDBC_USER=postgres
CRAWLER_DB_JDBC_PASSWORD=${POSTGRES_PASSWORD}
CRAWLER_ENVIRONMENT_ID=test
MY_EDC_FQDN=crawler.local
